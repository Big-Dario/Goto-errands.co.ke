# Copy to .env and edit. Never commit .env.

# --- Required for the admin dashboard ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# --- Server ---
HOST=127.0.0.1
PORT=8000
# SECRET_KEY=            # optional; auto-generated into .secret_key if empty
# ALLOWED_ORIGINS=https://yourname.github.io   # only if the frontend is hosted elsewhere
# TRUST_PROXY=1          # set when behind nginx/Caddy so rate limits see real IPs
# TIMEZONE=Africa/Nairobi

# --- Pricing (KES) ---
# PER_KM_FEE=30
# GOODS_FEE_RATE=0.05
# RIDER_SHARE=0.8

# --- M-Pesa ---
# mock = fake instant success after a few seconds (default, no money moves)
# sandbox / production = real Daraja STK Push
MPESA_MODE=mock
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE=https://api.yourdomain.com   # must be public HTTPS
